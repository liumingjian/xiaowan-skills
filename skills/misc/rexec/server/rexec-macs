#!/usr/bin/env bash
# List every registered mac with its online state, last source IP, and this session's default target.
# Column headers stay ASCII: double-width characters would skew the column alignment.
set -u
. /var/lib/rexec/bin/rexec-lib.sh
DEFAULT=$(resolve_mac 2>/dev/null || true)
LOGIN=$(session_mac)
USE=$(default_mac)
printf 'session login key: %s\n' "${LOGIN:-none (not a live ssh login, or an untagged key)}"
printf 'rexec --use default: %s\n\n' "${USE:-none}"
printf '%-3s %-18s %-8s %-16s %s\n' '' MAC STATE LAST-IP NAME
FOUND=0
for m in $(all_macs); do
  FOUND=1
  hb=$(mac_hb "$m")
  if mac_online "$m"; then st=ONLINE
  elif [ "$hb" = 0 ]; then st=NEVER
  else st=OFFLINE; fi
  d=''; [ "$m" = "$DEFAULT" ] && d='->'
  printf '%-3s %-18s %-8s %-16s %s\n' \
    "$d" "$m" "$st" "$(cat "$MACS/$m/origin" 2>/dev/null || echo -)" "$(mac_label "$m")"
done
[ "$FOUND" = 0 ] && echo '(no mac has registered yet)'
echo
if [ -z "$DEFAULT" ] || [ "$DEFAULT" = "__none__" ]; then
  echo 'no target: no agent is online, or several are online and neither a live login nor a default picks one.'
  echo 'start the agent on the mac you want, set one with rexec --use <name>, or pass rexec --mac <name>'
else
  echo '->  this session'"'"'s target; override per call with rexec --mac <name|prefix>'
fi
exit 0
