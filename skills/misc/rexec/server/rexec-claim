#!/usr/bin/env bash
# Called once per agent poll; one ssh round trip does three things: refresh the heartbeat, fetch the
# cancel list, and optionally claim one job.
# Usage: rexec-claim <MACID> <claim:0|1> <gate:open|closed> <running_count> <cpu%> <memfree%> <heavy_ok:0|1> [running_ids] [detached_ids]
# running_ids is the comma-separated list of jobs the agent is actually running ("-" when none). An agent
# that predates it sends nothing, which disables the reconciliation below rather than reaping everything.
# Queues are namespaced by MACID: a mac only sees, and only claims, jobs addressed to it.
# heavy_ok=1 means the agent's gate is open and the claim cooldown has elapsed, so another heavy job is fine.
# Light jobs (--no-sync / --light) ignore that flag, so they are still claimable with the gate closed.
# Output:
#   CANCEL=<space-separated ID list>
#   then the job body, or NONE
set -u
# Resolve siblings from this script's own directory, so the tree works both from /var/lib/rexec/bin
# (where /usr/local/bin/rexec is a symlink into it) and straight out of a checkout, which is what
# lets tests/queue-test.sh drive the real scripts against a REXEC_ROOT sandbox.
BIN=$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)
. "$BIN/rexec-lib.sh"
MACID="${1:?}"; WANT="${2:-0}"; GATE="${3:-open}"; NRUN="${4:-0}"
CPU="${5:--}"; MEM="${6:--}"; HEAVY_OK="${7:-1}"; RIDS="${8-}"; DIDS="${9-}"
case "$MACID" in *[!A-Za-z0-9_.-]*) echo "invalid MACID" >&2; exit 2;; esac
login_matches "$MACID" || { echo "this login's key is tagged for another mac, not $MACID" >&2; exit 2; }
NOW=$(date +%s)
M="$MACS/$MACID"
mac_dirs "$MACID"

# Temp files carry the PID so concurrent calls never mv away each other's intermediates.
printf '%s' "$NOW" > "$M/.alive.$$" && mv "$M/.alive.$$" "$M/agent.alive"
# Last source IP, for display only; routing goes by login key, never by IP.
# SSH_CLIENT is unset when this runs outside an ssh login (the test harness); keep set -u happy.
_CLI="${SSH_CLIENT-}"
note_origin "$MACID" "${_CLI%% *}"
printf 'TS=%s\nGATE=%s\nCPU=%s\nMEM=%s\nRUNNING=%s\n' \
  "$NOW" "$GATE" "$CPU" "$MEM" "$NRUN" > "$M/.gate.$$" \
  && mv "$M/.gate.$$" "$M/gate.status"

# Orphan result cleanup: when the caller exits via ESC or timeout nobody collects .done/.out and they pile up.
# Sweep every 10 minutes and drop anything over an hour old (on the normal path results are collected within a second).
SWEEP="$ROOT/.sweep"
if [ ! -f "$SWEEP" ] || [ -n "$(find "$SWEEP" -mmin +10 2>/dev/null)" ]; then
  : > "$SWEEP"
  find "$MACS"/*/results -type f -mmin +60 -delete 2>/dev/null || true
  # Finished detached jobs are kept far longer: their whole point is that nobody was waiting, so the
  # result has to survive until someone comes back for it. A week matches the log retention on the mac.
  for _d in "$MACS"/*/detached/*.done; do
    [ -e "$_d" ] || break
    [ -n "$(find "$_d" -mtime +7 2>/dev/null)" ] || continue
    rm -f "${_d%.done}".*
  done
fi

# Reconcile what we think is running with what the agent says it is running. Anything only we still hold is
# stranded: the agent lost it (restarted, or its local records were wiped) and will never report it, while
# every later job from its project queues behind a job that no longer exists. The grace period covers the one moment when the difference
# is legitimate - between claiming a job here and the agent listing it on its next poll.
# The age fallback needs no list at all, which is what reaches a mac still on an older agent: past its own
# --timeout the agent would have killed and reported it, so an entry that survives timeout plus a wide
# margin is proof the agent is not there to do either.
STRAND_GRACE=${REXEC_STRAND_GRACE:-120}
STRAND_SLACK=${REXEC_STRAND_SLACK:-300}
for r in "$M"/running/*.job; do
  [ -e "$r" ] || break
  rid=$(basename "$r" .job)
  # The agent says it is running this one: believe it, whatever its age.
  case ",$RIDS," in *",$rid,"*) continue;; esac
  rst=$(cat "$M/running/$rid.started" 2>/dev/null); case "$rst" in ''|*[!0-9]*) rst=0;; esac
  rage=0; [ "$rst" -gt 0 ] && rage=$(( NOW - rst ))
  if [ -n "$RIDS" ]; then
    [ "$rst" -gt 0 ] && [ "$rage" -le "$STRAND_GRACE" ] && continue
    reap_job "$MACID" "$rid" 129 "the agent on $MACID is no longer running this job (it restarted, or lost track of the job)"
  else
    # No list to go on - this agent predates it. Fall back on age: the agent enforces --timeout, so an entry
    # that outlives its own timeout by a wide margin proves no agent is there to enforce anything.
    rtmo=$(sed -n 's/^TIMEOUT=//p' "$r"); case "$rtmo" in ''|*[!0-9]*) rtmo=900;; esac
    [ "$rage" -gt $(( rtmo + STRAND_SLACK )) ] \
      && reap_job "$MACID" "$rid" 129 "the agent on $MACID never reported this job, and it is now far past its ${rtmo}s timeout"
  fi
done

# Reconcile against the callers. A `rexec` client heartbeats from submit until it collects its result, so
# a heartbeat that has stopped means nobody is waiting for that job any more - the session was compacted,
# OOM-killed, or its ssh link dropped (ESC is trapped and cancels properly, so it never lands here).
#   queued  -> drop it. Nothing has run yet, there is no result to deliver, and left alone it would sit in
#              the queue forever: nothing else expires a queued job, and an agent restart only ever
#              cleared running ones, which is why restarting the agent could not unstick this.
#   running -> ask the agent to cancel it. A build whose output nobody will ever read is pure waste, and
#              it holds its project's slot for as long as it runs.
for q in "$M"/queue/*.job; do
  [ -e "$q" ] || break
  qid=$(basename "$q" .job)
  caller_gone "$MACID" "$qid" || continue
  rm -f "$q" "$M/alive/$qid"
done
for r in "$M"/running/*.job; do
  [ -e "$r" ] || break
  rid=$(basename "$r" .job)
  caller_gone "$MACID" "$rid" || continue
  [ -e "$M/cancel/$rid" ] || : > "$M/cancel/$rid"
done

# Detached jobs: the agent reports which ones it can still see a live process group for. Anything else has
# died without reporting - the mac rebooted, or someone killed the process from outside. Only an agent that
# knows about detached jobs sends this list at all; without it we make no judgement, because the alternative
# is declaring jobs dead every time the user simply closes the agent's terminal.
if [ -n "$DIDS" ]; then
  for d in $(detached_active "$MACID"); do
    case ",$DIDS," in *",$d,"*) continue;; esac
    RAN=0
    DST=$(sed -n 's/^STARTED=//p' "$M/detached/$d.job"); case "$DST" in ''|*[!0-9]*) DST=0;; esac
    [ "$DST" -gt 0 ] && RAN=$(( NOW - DST ))
    printf '[rexec] the detached process for %s is gone from %s without reporting (the mac rebooted, or it was killed from outside)\n' \
      "$d" "$MACID" | openssl base64 -A | "$BIN/rexec-detached" done "$MACID" "$d" 129 "$RAN" >/dev/null 2>&1
  done
fi

# Cancel list: the agent kills the matching process groups, and report clears the markers afterwards.
CANCELS=""
for c in "$M"/cancel/*; do
  [ -e "$c" ] || break
  CANCELS="$CANCELS $(basename "$c")"
done
echo "CANCEL=${CANCELS# }"

[ "$WANT" = 1 ] || { echo NONE; exit 0; }

# Claim the first job in the queue that can actually run, walking the queue in submit order rather than
# looking only at its head. Considering only the head made execution order globally predictable, at the
# price of one project being able to stop the whole mac: a long job from project X, plus one more X job
# waiting, and every other project's work sat behind them for as long as the build took. Order within a
# project is still strictly FIFO - that is the constraint with real meaning behind it, since those jobs
# share one workspace directory - but projects no longer queue behind each other.
# Jobs submitted in the same second collide, so the submit sequence breaks the tie; otherwise this degrades to filename order.
QUEUED=$(for f in "$M"/queue/*.job; do
           [ -e "$f" ] || continue
           printf '%s %s %s\n' "$(sed -n 's/^SUBMIT=//p' "$f")" \
                                "$(sed -n 's/^SEQ=//p' "$f")" "$f"
         done | sort -n -k1,1 -k2,2 | cut -d' ' -f3-)

# A heredoc, not a pipe: the loop has to run in this shell or the job it picks is lost with the subshell.
PICK=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  HPROJ=$(sed -n 's/^PROJECT=//p' "$f")
  HWEIGHT=$(sed -n 's/^WEIGHT=//p' "$f")

  # Same project runs serially: one workspace directory cannot have two jobs rsyncing and running at once.
  # Skipping such a job never breaks FIFO within its project, because every later job of that project is
  # held by the very same running job.
  if [ "$HPROJ" != "__nosync__" ]; then
    BUSY=0
    for r in "$M"/running/*.job; do
      [ -e "$r" ] || break
      [ "$(sed -n 's/^PROJECT=//p' "$r")" = "$HPROJ" ] && { BUSY=1; break; }
    done
    # A detached job left running/ the moment it was launched, but it is still building in that same
    # workspace directory, and a job claimed now would rsync --delete the files out from under it.
    [ "$BUSY" = 0 ] && detached_holds "$MACID" "$HPROJ" && BUSY=1
    [ "$BUSY" = 1 ] && continue
  fi

  # Load gate plus claim cooldown: light jobs are entirely exempt, so keep scanning past a heavy job the
  # gate is holding - a zero-cost probe behind it should not wait for the machine to cool down.
  # When nothing is running (NRUN=0) one job goes through regardless, or a persistently busy mac stalls the queue forever.
  if [ "$HWEIGHT" != light ] && [ "$NRUN" -gt 0 ] && [ "$HEAVY_OK" != 1 ]; then continue; fi

  PICK="$f"; break
done <<QUEUE_EOF
$QUEUED
QUEUE_EOF
[ -n "$PICK" ] || { echo NONE; exit 0; }

ID=$(sed -n 's/^ID=//p' "$PICK")
if mv "$PICK" "$M/running/$ID.job" 2>/dev/null; then
  printf '%s' "$NOW" > "$M/running/$ID.started"
  cat "$M/running/$ID.job"
else
  echo NONE
fi
