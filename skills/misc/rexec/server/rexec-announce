#!/usr/bin/env bash
# Called once when the agent starts: register this mac's identity and human-readable label.
# Usage: rexec-announce <MACID> <LABEL_BASE64> [CAPS]
# CAPS is a comma-separated capability list from the agent; an older agent sends none, which is how the
# server tells "this agent cannot do it" from "this agent can".
set -u
. /var/lib/rexec/bin/rexec-lib.sh
MACID="${1:?}"; LABEL_B64="${2:-}"; CAPS="${3:-}"
case "$MACID" in *[!A-Za-z0-9_.-]*) echo "invalid MACID" >&2; exit 2;; esac
login_matches "$MACID" || { echo "this login's key is tagged for another mac, not $MACID" >&2; exit 2; }
mac_dirs "$MACID"
[ -n "$LABEL_B64" ] && printf '%s' "$LABEL_B64" | openssl base64 -d -A > "$MACS/$MACID/name" 2>/dev/null
printf '%s' "$CAPS" > "$MACS/$MACID/caps"
note_origin "$MACID" "${SSH_CLIENT%% *}"

# An agent that has just started is running nothing, so anything still marked running here belongs to a
# previous agent that never reported it - killed, crashed, or the mac slept. Finish those jobs now:
# restarting the agent is exactly what a user does to unstick the queue, and without this it is the one
# action that cannot work, because the stale entries survive the restart and keep blocking claims.
for _r in "$MACS/$MACID"/running/*.job; do
  [ -e "$_r" ] || break
  _rid=$(basename "$_r" .job)
  reap_job "$MACID" "$_rid" 129 "the agent on $MACID restarted while this job was running; it did not finish"
  echo "reaped stale job $_rid (left running by a previous agent)" >&2
done

echo "OK $MACID"
